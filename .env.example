# SMTP (contact form email delivery) — Gmail / Google Workspace example.
# See README for the App Password setup steps (no Google Cloud Console needed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@vrunisexsalon.com
SMTP_PASS=
CONTACT_TO_EMAIL=info@vrunisexsalon.com

# reCAPTCHA v2 (spam protection on the appointment form) — https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Instagram Graph API (live homepage feed) — see README for setup steps
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Admin panel — hosted Postgres (Neon / Vercel Postgres / Supabase).
# Use the pooled connection string. Same value locally and on Vercel.
DATABASE_URL=

# Admin panel image uploads — Vercel Blob (set automatically by Vercel once a
# Blob store is connected; leave empty locally to use the fs fallback).
BLOB_READ_WRITE_TOKEN=

# Admin login — generate the hash locally, keep the secret private.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Search engines. Left unset, the site is hidden from Google (robots.txt
# disallows everything and every page sends noindex) — correct for demo and
# preview URLs. On the real domain set ALLOW_INDEXING=true and SITE_URL to
# that domain to turn indexing and the sitemap on.
ALLOW_INDEXING=
SITE_URL=
